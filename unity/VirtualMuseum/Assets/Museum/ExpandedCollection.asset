    microscopeCaption: "\u6BBB\u306E\u6761\u7DDA\u3092\u30A4\u30E1\u30FC\u30B8\u3057\u305F\u6A21\u5F0F\u56F3"
  - title: "\u6C34\u6676\u306E\u7D50\u6676\u7FA4"
