# Blender-generated backups and autosaves
*.blend[0-9]
*.blend@

# Intermediate renders, scene revisions, and downloaded add-on inspection files
/work/*.blend
/work/*.png
/work/*.jpg
/work/*.zip
/work/addon_inspect/
/work/__pycache__/
/work/link_portability/
/work/*_log.txt
/work/inspection.txt
/work/link_check_*.txt
/work/link_modify.txt
/work/render_*.log
/work/prepare_*.log

# Rendered animation frames are generated from the Blender project
/outputs/renders/
