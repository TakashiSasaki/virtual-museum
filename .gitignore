# Blender backup and temporary files
*.blend[0-9]*
*.blend@*

# Unity generated files (keep Assets, Packages, ProjectSettings and .meta files)
/unity/**/[Ll]ibrary/
/unity/**/[Tt]emp/
/unity/**/[Oo]bj/
/unity/**/[Bb]uild/
/unity/**/[Bb]uilds/
/unity/**/[Ll]ogs/
/unity/**/[Uu]ser[Ss]ettings/
/unity/**/[Mm]emoryCaptures/
/unity/**/[Rr]ecordings/
/unity/**/Assets/AssetStoreTools*
/unity/**/*.csproj
/unity/**/*.sln
/unity/**/*.slnx
/unity/**/*.user
/unity/**/*.userprefs
/unity/**/*.pidb
/unity/**/*.svd
/unity/**/*.pdb
/unity/**/*.mdb
/unity/**/*.opendb
/unity/**/*.VC.db
/unity/**/sysinfo.txt
/unity/**/.vs/
/unity/**/.idea/

# Operating system files
.DS_Store
Thumbs.db
desktop.ini

# Existing museum project exclusions
# Blender-generated backups and autosaves
*.blend[0-9]
*.blend@

# Intermediate renders, scene revisions, and downloaded add-on inspection files
/work/*.blend
/work/*.png
/work/*.jpg
/work/*.zip
/work/addon_inspect/
/work/__pycache__/
/work/link_portability/
/work/*_log.txt
/work/inspection.txt
/work/link_check_*.txt
/work/link_modify.txt
/work/render_*.log
/work/prepare_*.log

# Rendered animation frames are generated from the Blender project
/outputs/renders/

# Reproducible Web-only preview meshes and bundle catalog
/unity/VirtualMuseum/Assets/Museum/GeneratedWeb/
/unity/VirtualMuseum/Assets/Museum/GeneratedWeb.meta
